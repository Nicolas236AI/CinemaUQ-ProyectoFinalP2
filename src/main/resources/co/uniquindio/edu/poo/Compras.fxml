<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.uniquindio.edu.poo.viewController.ComprasController"
      spacing="18"
      style="-fx-background-color: #111827;"
      prefWidth="900"
      prefHeight="650">

    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>

    <Label text="Gestión de compras"
           style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;"/>

    <Label text="Registra, consulta, actualiza y cancela compras."
           style="-fx-text-fill: #AAB7CC; -fx-font-size: 14px;"/>

    <Separator/>

    <Label text="Información de la compra"
           style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="12">
        <VBox spacing="7" HBox.hgrow="ALWAYS">
            <Label text="ID de compra"
                   style="-fx-text-fill: #D1D5DB;"/>
            <TextField fx:id="campoIdCompra"
                       promptText="Ej: C001"/>
        </VBox>

        <VBox spacing="7" HBox.hgrow="ALWAYS">
            <Label text="Fecha y hora"
                   style="-fx-text-fill: #D1D5DB;"/>
            <TextField fx:id="campoFecha"
                       promptText="2026-12-20 18:30"/>
        </VBox>

        <VBox spacing="7" HBox.hgrow="ALWAYS">
            <Label text="Total"
                   style="-fx-text-fill: #D1D5DB;"/>
            <TextField fx:id="campoTotal"
                       promptText="Ej: 30000"/>
        </VBox>
    </HBox>

    <HBox spacing="12">
        <VBox spacing="7" HBox.hgrow="ALWAYS">
            <Label text="Cliente"
                   style="-fx-text-fill: #D1D5DB;"/>
            <ComboBox fx:id="comboClientes"
                      promptText="Selecciona un cliente"
                      maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="7" HBox.hgrow="ALWAYS">
            <Label text="Estado"
                   style="-fx-text-fill: #D1D5DB;"/>
            <ComboBox fx:id="comboEstados"
                      promptText="Estado de la compra"
                      disable="true"
                      maxWidth="Infinity"/>
        </VBox>
    </HBox>

    <HBox spacing="10">
        <Button text="Registrar"
                onAction="#registrarCompra"
                style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-weight: bold;"/>

        <Button text="Actualizar"
                onAction="#actualizarCompra"
                style="-fx-background-color: #D97706; -fx-text-fill: white; -fx-font-weight: bold;"/>

        <Button text="Cancelar compra"
                onAction="#cancelarCompra"
                style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-font-weight: bold;"/>

        <Button text="Limpiar"
                onAction="#limpiarCampos"
                style="-fx-background-color: #374151; -fx-text-fill: white;"/>
    </HBox>

    <Separator/>

    <Label text="Compras registradas"
           style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TableView fx:id="tablaCompras"
               VBox.vgrow="ALWAYS">

        <columns>
            <TableColumn fx:id="columnaId"
                         text="ID"
                         prefWidth="90"/>

            <TableColumn fx:id="columnaFecha"
                         text="Fecha"
                         prefWidth="150"/>

            <TableColumn fx:id="columnaTotal"
                         text="Total"
                         prefWidth="100"/>

            <TableColumn fx:id="columnaEstado"
                         text="Estado"
                         prefWidth="120"/>

            <TableColumn fx:id="columnaCliente"
                         text="Cliente"
                         prefWidth="220"/>
        </columns>
    </TableView>

    <Label fx:id="mensajeEstado"
           text="Compras registradas: 0"
           style="-fx-text-fill: #93C5FD; -fx-font-size: 13px;"/>

</VBox>
