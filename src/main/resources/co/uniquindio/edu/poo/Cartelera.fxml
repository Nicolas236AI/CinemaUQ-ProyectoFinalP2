<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.uniquindio.edu.poo.viewController.CarteleraController"
      spacing="15"
      style="-fx-padding: 25;">

    <padding>
        <Insets top="20" right="25" bottom="20" left="25"/>
    </padding>

    <Label text="Gestión de cartelera"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <Label text="Registra, consulta, actualiza y elimina películas."
           style="-fx-font-size: 13px;"/>

    <Separator/>

    <Label text="Información de la película"
           style="-fx-font-size: 17px; -fx-font-weight: bold;"/>

    <HBox spacing="10">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="ID de película"/>
            <TextField fx:id="campoId"
                       promptText="Ej: P001"/>
        </VBox>

        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Título"/>
            <TextField fx:id="campoTitulo"
                       promptText="Nombre de la película"/>
        </VBox>
    </HBox>

    <HBox spacing="10">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Duración (minutos)"/>
            <TextField fx:id="campoDuracion"
                       promptText="Ej: 120"/>
        </VBox>

        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Género"/>
            <TextField fx:id="campoGenero"
                       promptText="Ej: Ciencia ficción"/>
        </VBox>
    </HBox>

    <HBox spacing="10">
        <Button text="Registrar"
                onAction="#registrarPelicula"
                style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>

        <Button text="Actualizar"
                onAction="#actualizarPelicula"
                style="-fx-background-color: #FF9800; -fx-text-fill: white;"/>

        <Button text="Eliminar"
                onAction="#eliminarPelicula"
                style="-fx-background-color: #F44336; -fx-text-fill: white;"/>

        <Button text="Limpiar"
                onAction="#limpiarCampos"/>
    </HBox>

    <Separator/>

    <Label text="Películas registradas"
           style="-fx-font-size: 17px; -fx-font-weight: bold;"/>

    <TableView fx:id="tablaPeliculas"
               VBox.vgrow="ALWAYS">

        <placeholder>
            <Label text="No hay películas registradas."/>
        </placeholder>

        <columns>
            <TableColumn fx:id="columnaId"
                         text="ID"
                         prefWidth="100"/>

            <TableColumn fx:id="columnaTitulo"
                         text="Título"
                         prefWidth="250"/>

            <TableColumn fx:id="columnaDuracion"
                         text="Duración (min)"
                         prefWidth="130"/>

            <TableColumn fx:id="columnaGenero"
                         text="Género"
                         prefWidth="200"/>
        </columns>
    </TableView>

    <Label fx:id="mensajeEstado"
           text="Listo."
           style="-fx-font-size: 12px; -fx-text-fill: #555555;"/>

</VBox>
