<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.uniquindio.edu.poo.viewController.SeleccionAsientosController"
      spacing="15"
      style="-fx-background-color: #111827;"
      prefWidth="950"
      prefHeight="680">

    <padding>
        <Insets top="20" right="25" bottom="20" left="25"/>
    </padding>

    <Label text="Reserva de Entradas, Asientos y Confitería"
           style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>

    <HBox spacing="15">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Cliente comprador" style="-fx-text-fill: #D1D5DB;"/>
            <ComboBox fx:id="comboClienteCompra" promptText="Selecciona un cliente" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Función en cartelera" style="-fx-text-fill: #D1D5DB;"/>
            <ComboBox fx:id="comboFuncionCompra" promptText="Selecciona película y horario" maxWidth="Infinity"/>
        </VBox>
    </HBox>

    <HBox spacing="20" VBox.vgrow="ALWAYS">

        <!-- IZQUIERDA: MAPA DE SALA -->
        <VBox spacing="12" HBox.hgrow="ALWAYS"
              style="-fx-background-color: #172235; -fx-background-radius: 10; -fx-padding: 18;">

            <Label text="PANTALLA"
                   alignment="CENTER"
                   maxWidth="Infinity"
                   style="-fx-background-color: #293950; -fx-text-fill: #93C5FD; -fx-font-weight: bold; -fx-padding: 6; -fx-background-radius: 6;"/>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background: #172235; -fx-background-color: #172235;">
                <GridPane fx:id="gridAsientos"
                          hgap="8"
                          vgap="8"
                          alignment="CENTER"
                          style="-fx-padding: 10;"/>
            </ScrollPane>

            <HBox spacing="15" alignment="CENTER">
                <Label text="■ Disponible" style="-fx-text-fill: #3B82F6; -fx-font-weight: bold;"/>
                <Label text="■ Seleccionado" style="-fx-text-fill: #F59E0B; -fx-font-weight: bold;"/>
                <Label text="■ Ocupado" style="-fx-text-fill: #6B7280; -fx-font-weight: bold;"/>
                <Label text="♿ Accesible" style="-fx-text-fill: #10B981; -fx-font-weight: bold;"/>
            </HBox>

        </VBox>

        <!-- DERECHA: CONFITERÍA, DESCUENTO Y RESUMEN -->
        <VBox spacing="12" prefWidth="350"
              style="-fx-background-color: #172235; -fx-background-radius: 10; -fx-padding: 18;">

            <Label text="Opciones de Boleto y Confitería"
                   style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>

            <CheckBox fx:id="checkBoletoAdicional"
                      text="Agregar servicio adicional / 3D (+$5.000 por boleto)"
                      style="-fx-text-fill: #DCE5F2;"/>

            <Separator/>

            <Label text="Agregar producto o combo" style="-fx-text-fill: #D1D5DB;"/>
            <HBox spacing="8">
                <ComboBox fx:id="comboConfiteria" promptText="Producto / Combo" HBox.hgrow="ALWAYS"/>
                <Spinner fx:id="spinnerCantidadConfiteria" prefWidth="70"/>
                <Button text="+"
                        onAction="#agregarConfiteriaAlCarrito"
                        style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>

            <ListView fx:id="listaResumenCarrito" prefHeight="130"/>

            <VBox spacing="5">
                <Label text="Promoción / Descuento aplicable" style="-fx-text-fill: #D1D5DB;"/>
                <ComboBox fx:id="comboPromocion" promptText="Sin descuento" maxWidth="Infinity"/>
            </VBox>

            <Separator/>

            <VBox spacing="4">
                <Label fx:id="etiquetaAsientosSeleccionados" text="Asientos: Ninguno" style="-fx-text-fill: #F59E0B;"/>
                <Label fx:id="etiquetaTotalPagar" text="Total a pagar: $0.00" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Label fx:id="etiquetaPuntosGanados" text="Puntos a acumular: 0 pts" style="-fx-text-fill: #34D399; -fx-font-size: 12px;"/>
            </VBox>

            <Button text="CONFIRMAR Y PAGAR CON TARJETA"
                    onAction="#confirmarYPagarCompra"
                    maxWidth="Infinity"
                    style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12;"/>

            <Button text="Limpiar selección"
                    onAction="#limpiarSeleccion"
                    maxWidth="Infinity"
                    style="-fx-background-color: #374151; -fx-text-fill: white;"/>

        </VBox>

    </HBox>

    <Label fx:id="mensajeEstado"
           text="Selecciona una función y haz clic en los asientos disponibles (máximo 6 entradas)."
           style="-fx-text-fill: #93C5FD; -fx-font-size: 13px;"/>

</VBox>